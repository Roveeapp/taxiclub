# ═══════════════════════════════════════════════════════════════
# Club Taxis Asturias — variables de entorno
# Copia este fichero a .env y rellena los valores.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
# Estas tres son la fuente única de verdad: nuxt.config.ts las
# mapea a todos los consumidores (módulo @nuxtjs/supabase,
# runtimeConfig público/privado y los scripts de scripts/).
# No añadas SUPABASE_KEY ni SUPABASE_SERVICE_KEY: son los nombres
# que el módulo usaría por defecto, pero ya se los pasamos
# explícitamente desde estas variables.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Conexión directa a Postgres. Solo la necesitan los scripts de
# scripts/ (seed, check, create-admin, apply-migration…), no la app.
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── App ────────────────────────────────────────────────────────
# En local: http://localhost:3000
NUXT_PUBLIC_APP_URL=https://clubtaxisasturias.es

# ── Geocoding (OpenStreetMap / Nominatim) ──────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ── Push notifications (VAPID) ─────────────────────────────────
# Genera un par con:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log('pub',publicKey.export({type:'spki',format:'der'}).subarray(-65).toString('base64url'));console.log('priv',privateKey.export({format:'jwk'}).d)"
# Cambiar el par invalida las suscripciones push ya registradas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=admin@clubtaxisasturias.es

# ═══════════════════════════════════════════════════════════════
# OPCIONALES
# Stripe, Resend y Twilio se configuran preferentemente desde el
# panel de admin (/admin/configuracion), que las guarda en la tabla
# integration_settings. Ver app/server/utils/integrations.ts: la BD
# tiene prioridad y el .env solo actúa de fallback.
# ═══════════════════════════════════════════════════════════════

# ── Stripe (pagos) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@clubtaxisasturias.es

# ── SMS (Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+34...

# ── Scripts y tests (no los usa la app) ────────────────────────
# scripts/create-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=
# playwright.config.ts — si se define, no arranca su propio dev server
E2E_BASE_URL=

# ═══════════════════════════════════════════════════════════════
# NOTA — Edge Functions (supabase/functions/)
# Corren en el entorno de Supabase, no leen este .env. Sus
# variables (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, APP_URL,
# RESEND_API_KEY, EMAIL_FROM, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET) se configuran con:
#   supabase secrets set NOMBRE=valor
# ═══════════════════════════════════════════════════════════════
